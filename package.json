{
  "name": "codecatalyst-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "node start-all.js",
    "start": "node start-all.js",
    "dev:all": "node start-all.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:mobile": "npm --prefix mobile run start",
    "dev:ai": "python ai-engine/main.py",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "build:mobile": "npm --prefix mobile run build",
    "build": "npm run build:frontend",
    "db:seed": "npm --prefix backend run db:seed",
    "test": "node tests/run-tests.js",
    "fetch:data": "./ai-engine/venv/bin/python scripts/fetch_kaggle_dataset.py",
    "lint": "npm --prefix frontend run lint"
  }
}
